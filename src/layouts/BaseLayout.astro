---
import "../styles/global.css";
import { nav, profile } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `Bugyalu — ${profile.name}`,
  description = `${profile.name}的个人空间：技术笔记、项目和一些正在形成的想法。`,
} = Astro.props;

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname.startsWith(href);
---

<!doctype html>
<html lang="zh-CN" data-theme="night">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css"
    />
    <script is:inline>
      const saved = localStorage.getItem("theme");
      document.documentElement.dataset.theme = saved === "day" ? "day" : "night";
      window.__toggleTheme = () => {
        const next =
          document.documentElement.dataset.theme === "night" ? "day" : "night";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        window.dispatchEvent(new CustomEvent("themechange", { detail: next }));
      };
    </script>
    <title>{title}</title>
  </head>
  <body>
    <header class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
      <div class="glass flex items-center gap-1 rounded-full py-1.5 pl-2 pr-1.5 shadow-[0_8px_32px_rgba(0,0,0,0.18)]">
        <a
          href="/"
          class="flex items-center gap-2 rounded-full px-2.5 py-1 text-sm font-medium text-ink transition-colors hover:text-accent"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <ellipse cx="12" cy="13.5" rx="6.5" ry="7" fill="currentColor" opacity="0.9" />
            <circle cx="12" cy="5.5" r="3" fill="currentColor" />
            <path d="M10 3 8.6 1.2M14 3l1.4-1.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            <path d="M6 12H3M6 16l-2.6 1.6M18 12h3M18 16l2.6 1.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            <path d="M12 7.5v13" stroke="var(--bg)" stroke-width="1.1" />
            <circle cx="9.4" cy="11" r="1" fill="var(--bg)" />
            <circle cx="14.6" cy="15" r="1" fill="var(--bg)" />
          </svg>
          <span class="font-mono text-xs tracking-[0.06em]">bugyalu</span>
        </a>
        <nav aria-label="主导航" class="flex items-center">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "rounded-full px-2.5 py-1.5 text-[0.82rem] transition-colors hover:text-accent sm:px-3",
                  isActive(item.href) ? "text-ink" : "text-mute",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button
          id="theme-toggle"
          type="button"
          aria-label="切换昼夜"
          class="ml-1 flex h-7 w-7 items-center justify-center rounded-full text-mute transition-colors hover:text-accent"
        >
          <svg class="theme-icon-sun hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6" />
          </svg>
          <svg class="theme-icon-moon hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
          </svg>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="relative bg-bg">
      <div class="shell flex flex-col gap-6 border-t border-line py-14 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-display text-base text-ink">把小屋收拾好，随时来写东西。</p>
          <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 font-mono text-xs text-mute">
            <a class="transition-colors hover:text-accent" href={`mailto:${profile.email}`}>{profile.email}</a>
            <a class="transition-colors hover:text-accent" href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </div>
        <p class="font-mono text-[0.68rem] text-faint">© {new Date().getFullYear()} bugyalu</p>
      </div>
    </footer>
    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => window.__toggleTheme());
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.08, rootMargin: "0px 0px -4% 0px" },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
    <style>
      [data-theme="night"] .theme-icon-sun { display: block; }
      [data-theme="day"] .theme-icon-moon { display: block; }
    </style>
  </body>
</html>
