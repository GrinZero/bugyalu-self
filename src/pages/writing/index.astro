---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import WritingArchive from "../../components/WritingArchive.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

---

<BaseLayout title="手记 — Bugyalu" description="关于工程、AI、产品体验和那些还没有被压缩成一句结论的东西。">
  <section class="shell pb-24 pt-28 md:pt-36">
    <PageHeader
      eyebrow="Writing / field notes"
      title="写下来，才想得清楚。"
      description="关于工程、AI、产品体验和那些还没有被压缩成一句结论的东西。"
    />

    <WritingArchive posts={posts} />
  </section>
</BaseLayout>
