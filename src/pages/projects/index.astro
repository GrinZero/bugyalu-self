---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const kindLabel = {
  "open-source": "开源",
  internal: "内部平台",
  experiment: "实验",
} as const;
---

<BaseLayout title="作品 — Bugyalu" description="开源工具、内部平台与实验：node-network-devtools、dpdm-fast、BugSpy、食尾蛇工作流、Brand Figma Plugin。">
  <section class="shell pb-24 pt-28 md:pt-36">
    <PageHeader
      eyebrow="Projects / things shipped"
      title="做过的东西，都还在跑。"
      description="从 Node.js 官方网络调试能力的基础实现，到把 CI 检查提速 20 倍的 Rust 工具，再到能回放灾难现场的调试系统。"
    />

    <div>
      {
        projects.map((project, i) => (
          <a
            href={`/projects/${project.id}/`}
            class="group -mx-4 flex items-start gap-4 rounded-xl px-4 py-5 transition-colors duration-200 hover:bg-card"
            data-reveal
            style={`--reveal-delay:${Math.min(i, 8) * 40}ms`}
          >
            <span class="mt-0.5 shrink-0 text-xl leading-none">{project.data.icon}</span>
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="truncate font-display text-[1.05rem] leading-7 text-ink transition-colors group-hover:text-accent">
                  {project.data.title}
                </h2>
                <span class="shrink-0 font-mono text-[0.7rem] text-faint">
                  {kindLabel[project.data.kind]}{project.data.period ? ` · ${project.data.period}` : ""}
                </span>
              </div>
              <p class="mt-1 line-clamp-2 text-[0.82rem] leading-6 text-mute">{project.data.tagline}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
