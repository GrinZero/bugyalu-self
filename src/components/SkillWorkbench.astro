---
import { skillDomains } from "../data/site";
const labels = ["FRONTEND", "BACKEND", "AI SYSTEMS", "DEVOPS", "PRODUCT"];
const symbols = ["</>", "{ }", "✳", ">_", "⌘"];
const colors = ["var(--s-devtools)", "var(--s-note)", "var(--s-agent)", "var(--s-field)", "var(--link)"];
---

<skill-workbench aria-labelledby="skills-title">
  <section class="expertise">
    <header class="expertise-heading">
      <div>
        <p class="eyebrow">The full stack / 专业能力</p>
        <h2 id="skills-title">深入每一层。<br /><span>连接整个产品。</span></h2>
      </div>
      <p class="heading-note">从看得见的交互，到背后的系统。<br />选择一层，看看我能做什么。</p>
    </header>

    <div class="workbench">
      <div class="workbench-bar" aria-hidden="true">
        <span><i></i> BUGYALU / ENGINEERING</span>
        <span>DESIGN → BUILD → SHIP</span>
      </div>
      <div class="workbench-body">
        <div class="stack-navigation">
          <p class="stack-caption" aria-hidden="true">EXPLORE THE LAYERS <span>↘</span></p>
          <div class="stack-tabs" aria-label="专业能力领域">
            {skillDomains.map((domain, i) => (
              <button type="button" class="stack-layer" id={`tab-${domain.id}`} data-index={i} style={`--layer-color:${colors[i]}`}>
                <span class="layer-symbol" aria-hidden="true">{symbols[i]}</span>
                <span class="layer-label"><strong>{labels[i]}</strong><span>{domain.name}</span></span>
                <span class="layer-arrow" aria-hidden="true">↗</span>
              </button>
            ))}
          </div>
          <div class="stack-base" aria-hidden="true"><span>FULL</span><span>STACK<span class="base-dot">.</span></span></div>
        </div>

        <div class="skill-panels">
          {skillDomains.map((domain, i) => (
            <article class="skill-panel" id={`panel-${domain.id}`} style={`--domain-color:${colors[i]}`}>
              <div class="panel-heading">
                <div class="domain-label" data-enter>
                  <p>{labels[i]}</p>
                  {domain.evidence && (
                    <a class="evidence-link" href={domain.evidence.href}>{domain.evidence.label}<span aria-hidden="true">↗</span></a>
                  )}
                </div>
                <h3 data-enter>{domain.name}</h3>
                <p class="domain-summary" data-enter>{domain.summary}</p>
              </div>
              <dl class="capabilities">
                {domain.capabilities.map(capability => (
                  <div class="capability" data-enter>
                    <dt><span aria-hidden="true">+</span>{capability.name}</dt>
                    <dd>{capability.detail}</dd>
                  </div>
                ))}
              </dl>
              <ul class="technologies" aria-label={`${domain.name}相关技术与实践`}>
                {domain.stack.map(technology => <li data-enter>{technology}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
      <div class="workbench-footer"><span>以真实项目为基础，持续向下一层探索。</span><span aria-hidden="true">CRAFT & CURIOSITY ↗</span></div>
    </div>
  </section>
</skill-workbench>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  class SkillWorkbench extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>(".stack-layer"));
      const panels = Array.from(this.querySelectorAll<HTMLElement>(".skill-panel"));
      const tablist = this.querySelector<HTMLElement>(".stack-tabs")!;
      const navigation = this.querySelector<HTMLElement>(".stack-navigation")!;
      const media = gsap.matchMedia();
      let active = 0;
      this.classList.add("is-enhanced");
      tablist.setAttribute("role", "tablist");
      tabs.forEach((tab, i) => {
        tab.setAttribute("role", "tab");
        tab.setAttribute("aria-controls", panels[i].id);
        panels[i].setAttribute("role", "tabpanel");
        panels[i].setAttribute("aria-labelledby", tab.id);
        panels[i].tabIndex = 0;
      });

      media.add({ all: "(min-width: 0px)", desktop: "(min-width: 760px)", reduce: "(prefers-reduced-motion: reduce)", fine: "(hover: hover) and (pointer: fine)" }, context => {
        const { desktop, reduce, fine } = context.conditions!;
        const events = new AbortController();
        let transition: gsap.core.Timeline | undefined;
        const sync = () => {
          tablist.setAttribute("aria-orientation", desktop ? "vertical" : "horizontal");
          tabs.forEach((tab, i) => {
            const selected = i === active;
            tab.setAttribute("aria-selected", String(selected));
            tab.tabIndex = selected ? 0 : -1;
            panels[i].hidden = !selected;
            panels[i].inert = !selected;
          });
        };
        const positionLayers = (animate = true) => {
          tabs.forEach((tab, i) => {
            gsap.to(tab, { x: desktop ? (i === active ? 22 : 0) : 0, y: 0, rotation: desktop ? -7 : 0,
              rotationX: 0, autoAlpha: 1, scale: i === active && desktop ? 1.03 : 1,
              duration: animate && !reduce ? 0.65 : 0, ease: "elastic.out(1, 0.7)", overwrite: true });
          });
        };
        sync();
        positionLayers(false);

        const entrance = gsap.timeline({ scrollTrigger: { trigger: this, start: "top 82%", once: true } });
        if (!reduce) {
          entrance.from(this.querySelector(".expertise-heading"), { autoAlpha: 0, y: 30, duration: 0.75, ease: "power3.out" })
            .from(this.querySelector(".workbench"), { autoAlpha: 0, y: 45, duration: 0.8, ease: "power3.out" }, 0.12)
            .from(tabs, { autoAlpha: 0, y: 65, rotationX: desktop ? -45 : 0, stagger: 0.075, duration: 0.8, ease: "power3.out" }, 0.3);
        }

        const select = (index: number) => {
          if (index === active) return;
          entrance.progress(1);
          transition?.kill();
          panels.forEach(panel => gsap.set(panel.querySelectorAll("[data-enter]"), { clearProps: "all" }));
          active = index;
          sync();
          positionLayers();
          if (!reduce) {
            transition = gsap.timeline().fromTo(panels[active].querySelectorAll("[data-enter]"),
              { autoAlpha: 0, y: 17, x: 6 },
              { autoAlpha: 1, y: 0, x: 0, duration: 0.5, stagger: 0.035, ease: "power3.out", clearProps: "all" });
          }
        };
        tabs.forEach((tab, i) => {
          tab.addEventListener("click", () => select(i), { signal: events.signal });
          tab.addEventListener("keydown", event => {
            let next = i;
            if (event.key === "Home") next = 0;
            else if (event.key === "End") next = tabs.length - 1;
            else if (event.key === (desktop ? "ArrowDown" : "ArrowRight")) next = (i + 1) % tabs.length;
            else if (event.key === (desktop ? "ArrowUp" : "ArrowLeft")) next = (i + tabs.length - 1) % tabs.length;
            else return;
            event.preventDefault();
            select(next);
            tabs[next].focus({ preventScroll: true });
          }, { signal: events.signal });

        });
        if (!reduce && desktop && fine) {
          const tiltX = gsap.quickTo(tablist, "x", { duration: 0.65, ease: "power3.out" });
          const tiltY = gsap.quickTo(tablist, "y", { duration: 0.65, ease: "power3.out" });
          navigation.addEventListener("pointermove", event => {
            const bounds = navigation.getBoundingClientRect();
            tiltX(((event.clientX - bounds.left) / bounds.width - 0.5) * 4);
            tiltY(((event.clientY - bounds.top) / bounds.height - 0.5) * -4);
          }, { signal: events.signal });
          navigation.addEventListener("pointerleave", () => { tiltX(0); tiltY(0); }, { signal: events.signal });
        }
        return () => { events.abort(); transition?.kill(); gsap.killTweensOf(tabs); };
      });
      this.dispose = () => media.revert();
    }

    disconnectedCallback() { this.dispose?.(); }
  }
  if (!customElements.get("skill-workbench")) customElements.define("skill-workbench", SkillWorkbench);
</script>

<style>
  skill-workbench { display: block; margin-top: 6rem; }
  .expertise { width: min( calc(100vw - 3rem), 62rem); position: relative; left: 50%; transform: translateX(-50%); }
  .expertise-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  h2 { margin-top: 1.1rem; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.4; letter-spacing: -.04em; scroll-margin-top: 6rem; }
  h2 span { color: var(--ink-2); }
  .heading-note { font-size: .8rem; line-height: 1.9; color: var(--ink-2); padding-bottom: .5rem; }
  .workbench { border: 1px solid var(--line-strong); border-radius: 1.5rem; background: var(--soft); overflow: hidden; box-shadow: 0 24px 70px -40px #0008; }
  .workbench-bar, .workbench-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.75rem; color: var(--ink-2); font: .6rem var(--font-mono); letter-spacing: .06em; }
  .workbench-bar { border-bottom: 1px solid var(--line); }
  .workbench-bar span:first-child { display: flex; align-items: center; gap: .6rem; }
  .workbench-bar i { width: 5px; height: 5px; border-radius: 50%; background: var(--link); box-shadow: 0 0 10px color-mix(in srgb, var(--link) 50%, transparent); }
  .workbench-body { display: grid; grid-template-columns: 35% minmax(0,1fr); }
  .stack-navigation { display: none; position: relative; padding: 2rem 1.8rem; border-right: 1px solid var(--line); perspective: 900px; background-image: radial-gradient(var(--line-strong) .65px, transparent .65px); background-size: 16px 16px; }
  .is-enhanced .stack-navigation { display: block; }
  .stack-caption { font: .58rem var(--font-mono); letter-spacing: .12em; color: var(--ink-2); display: flex; justify-content: space-between; }
  .stack-caption span { font-size: 1rem; }
  .stack-tabs { position: relative; margin: 2.5rem .7rem 0 0;  }
  .stack-layer { position: relative; display: flex; align-items: center; gap: .85rem; width: 100%; min-height: 72px; padding: .8rem 1rem; margin-top: -2px; text-align: left; cursor: pointer; border: 1px solid var(--line-strong); border-radius: .7rem; background: var(--card); color: var(--ink-2); box-shadow: 0 6px 0 var(--bg), 0 7px 0 var(--line-strong), 0 14px 18px -9px #0008; transform-origin: center; }
  .stack-layer[aria-selected="true"] { border-color: var(--layer-color); background: color-mix(in srgb, var(--layer-color) 12%, var(--card)); color: var(--ink); z-index: 2; box-shadow: 0 6px 0 var(--bg), 0 7px 0 var(--layer-color), 0 15px 30px -15px var(--layer-color); }
  .layer-symbol { font: 1.3rem var(--font-mono); color: var(--layer-color); width: 2.25rem; flex-shrink: 0; white-space: nowrap; }
  .layer-label { display: grid; gap: .3rem; }
  .layer-label strong { font: 500 .7rem var(--font-mono); letter-spacing: .06em; }
  .layer-label > span { font-size: .65rem; }
  .layer-arrow { margin-left: auto; color: var(--layer-color); opacity: 0; }
  .stack-layer[aria-selected="true"] .layer-arrow { opacity: 1; }
  .stack-base { margin-top: 2.5rem; font: 800 3.8rem/.85 var(--font-sans); letter-spacing: -.075em; color: var(--ink); opacity: .13; display: grid; pointer-events: none; }
  .base-dot { color: var(--accent); }
  .skill-panels { min-width: 0; }
  .is-enhanced .skill-panels { display: grid; }
  .skill-panel { position: relative; padding: 2.5rem 2.75rem 2rem; min-width: 0; }
  .is-enhanced .skill-panel { grid-area: 1 / 1; }
  .is-enhanced .skill-panel[hidden] { display: block; visibility: hidden; pointer-events: none; }
  .skill-panel::before { content: ""; position: absolute; top: 0; right: 0; width: 16rem; height: 15rem; background: radial-gradient(ellipse at top right, color-mix(in srgb, var(--domain-color) 10%, transparent), transparent 70%); pointer-events: none; }
  .domain-label { display: flex; align-items: center; justify-content: space-between; font: .67rem var(--font-mono); letter-spacing: .13em; color: var(--domain-color); }
  .domain-label { gap: .75rem; flex-wrap: wrap; }
  .evidence-link { display: inline-flex; align-items: center; gap: .4rem; min-height: 36px; font: .7rem var(--font-sans); letter-spacing: 0; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--domain-color) 40%, transparent); text-underline-offset: 5px; }
  .evidence-link:hover { text-decoration-color: currentColor; }
  .evidence-link span { font-size: 1rem; transition: transform .2s ease; }
  .evidence-link:hover span { transform: translate(2px, -2px); }
  h3 { margin-top: 1rem; font: 500 clamp(1.8rem, 3vw, 2.35rem)/1.4 var(--font-display); letter-spacing: -.035em; }
  .domain-summary { margin-top: .8rem; font-size: .83rem; line-height: 1.9; color: var(--ink-2); max-width: 26rem; }
  .capabilities { margin-top: 1.8rem; }
  .capability { border-top: 1px solid var(--line); padding: 1rem 0; }
  .capability dt { font-size: .88rem; font-weight: 500; display: flex; align-items: center; gap: .65rem; }
  .capability dt span { font: .9rem var(--font-mono); color: var(--domain-color); }
  .capability dd { margin: .4rem 0 0 1.2rem; font-size: .78rem; line-height: 1.85; color: var(--ink-2); }
  .technologies { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1.1rem; }
  .technologies li { font: .62rem/1.5 var(--font-mono); padding: .3rem .55rem; border: 1px solid var(--line); border-radius: .3rem; color: var(--ink-2); background: color-mix(in srgb, var(--domain-color) 4%, transparent); }
  .workbench-footer { border-top: 1px solid var(--line); font-size: .58rem; }
  skill-workbench:not(.is-enhanced) .workbench-body { display: block; }
  skill-workbench:not(.is-enhanced) .skill-panel + .skill-panel { border-top: 1px solid var(--line); }
  @media (max-width: 759px) {
    .expertise-heading { display: block; margin-bottom: 1.5rem; }
    .heading-note { margin-top: 1rem; font-size: .75rem; }
    .workbench-bar, .workbench-footer { padding: 1rem 1.25rem; }
    .workbench-bar span:last-child, .workbench-footer span:last-child { display: none; }
    .workbench-body { grid-template-columns: minmax(0,1fr); }
    .stack-navigation { padding: 1rem 1.25rem; border-right: 0; border-bottom: 1px solid var(--line); background: none; }
    .stack-caption, .stack-base, .layer-symbol, .layer-arrow, .layer-label strong { display: none; }
    .stack-tabs { display: flex; flex-wrap: wrap; gap: .45rem; margin: 0; }
    .stack-layer { width: auto; min-height: 38px; margin: 0; padding: .5rem .75rem; border-radius: .4rem; box-shadow: none; }
    .layer-label > span { font-size: .7rem; }
    .stack-layer[aria-selected="true"] { box-shadow: inset 0 -2px 0 var(--layer-color); }
    .skill-panel { padding: 1.6rem 1.25rem; }
    h3 { font-size: 1.8rem; }
    .capabilities { margin-top: 1.4rem; }
  }
</style>
