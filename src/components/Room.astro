<canvas id="room-canvas" class="pointer-events-none fixed inset-0 h-full w-full" aria-label="可互动的工作台"></canvas>
<div id="room-toolbar" hidden class="fixed right-4 top-4 z-[60] flex gap-2">
  <button id="room-reset" aria-label="重置物体位置和状态" title="重置物体位置和状态" class="room-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 10a9 9 0 1 1 2 8M3 4v6h6"/></svg></button>
  <button id="room-view-toggle" aria-label="退出 3D 视角" title="退出 3D 视角（Esc）" class="room-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button>
</div>
<style>
  .room-icon { display:grid; place-items:center; width:38px; height:38px; border:1px solid var(--line); border-radius:50%; background:var(--bg); color:var(--ink); cursor:pointer; }
  .room-icon svg { width:18px; height:18px; }
  [hidden] { display:none !important; }
</style>
<script>
  import { initRoom } from "../scripts/room";
  const el = document.getElementById("room-canvas");
  if (el instanceof HTMLCanvasElement) initRoom(el);
</script>
